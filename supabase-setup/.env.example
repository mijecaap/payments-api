# Variables de Entorno para Plataforma Electoral Perú 2026

# ===============================================
# CONFIGURACIÓN DE SUPABASE
# ===============================================
# URL del proyecto de Supabase (reemplazar con tu proyecto real)
SUPABASE_URL=https://tu-proyecto-id.supabase.co
# Clave pública (anon key) - segura para usar en frontend
SUPABASE_ANON_KEY=tu_clave_anonima_aqui
# Clave de servicio - MANTENER SECRETA, solo para backend
SUPABASE_SERVICE_KEY=tu_clave_de_servicio_aqui

# ===============================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# ===============================================
# Configuración directa a PostgreSQL de Supabase
DB_HOST=db.tu-proyecto-id.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_de_bd
DB_NAME=postgres

# ===============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===============================================
NODE_ENV=development
PORT=4000

# Secreto JWT para autenticación (generar uno único y seguro)
JWT_SECRET=tu_jwt_secret_muy_seguro_para_peru_2026_elecciones

# Configuración de encriptación
BCRYPT_SALT_ROUNDS=12

# ===============================================
# CONFIGURACIÓN DE STORAGE (SUPABASE)
# ===============================================
# Bucket para almacenamiento de archivos
SUPABASE_STORAGE_BUCKET=candidatos-media

# URLs base para diferentes tipos de archivos
CANDIDATE_PHOTOS_URL=https://tu-proyecto-id.supabase.co/storage/v1/object/public/candidatos-media/photos/
PARTY_LOGOS_URL=https://tu-proyecto-id.supabase.co/storage/v1/object/public/candidatos-media/logos/
DOCUMENTS_URL=https://tu-proyecto-id.supabase.co/storage/v1/object/public/candidatos-media/documents/

# ===============================================
# CONFIGURACIÓN DE API EXTERNA (OPCIONAL)
# ===============================================
# APIs para datos adicionales de encuestas, noticias, etc.
POLLING_API_URL=https://api.encuestas-peru.com
POLLING_API_KEY=tu_api_key_encuestas

NEWS_API_URL=https://api.noticias-peru.com
NEWS_API_KEY=tu_api_key_noticias

# ===============================================
# CONFIGURACIÓN DE CORS
# ===============================================
# Dominios permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,https://tu-frontend.com,https://elecciones-peru-2026.com

# ===============================================
# CONFIGURACIÓN DE LOGGING
# ===============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===============================================
# CONFIGURACIÓN DE RATE LIMITING
# ===============================================
# Límites para prevenir abuso de API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================================
# CONFIGURACIÓN DE CACHE (REDIS - OPCIONAL)
# ===============================================
# Si decides implementar cache con Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ===============================================
# CONFIGURACIÓN DE MONITOREO (OPCIONAL)
# ===============================================
# Para servicios de monitoreo como Sentry
SENTRY_DSN=https://tu-sentry-dsn.ingest.sentry.io/

# ===============================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ===============================================
# Para notificaciones y actualizaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu_password_email

# ===============================================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================================
# Claves para encriptación adicional
ENCRYPTION_KEY=tu_clave_de_encriptacion_32_chars
API_SECRET_KEY=tu_clave_secreta_para_apis

# ===============================================
# CONFIGURACIÓN DE DESARROLLO LOCAL
# ===============================================
# Solo para desarrollo local con Supabase CLI
SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=tu_clave_local_anonima